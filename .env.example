# Copy to .env.local for local development. Set the same names in Vercel
# (Settings → Environment Variables) for Production and Preview.
# All of these are server-only except the NEXT_PUBLIC_ ones.

# Digital twin (server only)
OPENAI_API_KEY=
# Optional: defaults to gpt-5.4-mini, the model the Render twin used.
OPENAI_MODEL=
# Optional: total twin answers allowed per day across all visitors (default 400).
TWIN_DAILY_LIMIT=

# Miki → Christian on Telegram (owner-only bot). Replaces Pushover once set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_USER_ID=
OWNER_TELEGRAM_CHAT_ID=

# Legacy alerts, used only until Telegram is configured.
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Internal secrets (random, server-only): stored OAuth token encryption, signed one-time
# links, the 15-minute job (also a GitHub Actions secret) and Vercel Cron.
TOKEN_ENCRYPTION_KEY=
ACTION_SIGNING_SECRET=
JOB_SECRET=
CRON_SECRET=

# Rate limiting (Upstash Redis, REST API section of the database page)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact form (EmailJS; visible in the browser by design)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Analytics (optional; PostHog EU, cookieless). Leave empty to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
